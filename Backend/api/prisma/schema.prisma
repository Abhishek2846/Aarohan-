generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  user_id                                                  String                      @id @default(uuid()) @db.Uuid
  login_name                                               String                      @unique(map: "uq_users_login_name") @db.VarChar(80)
  email                                                    String                      @unique(map: "uq_users_email") @db.VarChar(254)
  password_hash                                            String                      @db.VarChar(255)
  full_name                                                String                      @db.VarChar(160)
  designation                                              String?                     @db.VarChar(160)
  department                                               String?                     @db.VarChar(180)
  phone_e164                                               String?                     @db.VarChar(20)
  account_status                                           String                      @default("INVITED")
  preferred_language                                       String                      @default("en") @db.VarChar(10)
  mfa_enabled                                              Boolean                     @default(false)
  last_login_at                                            DateTime?                   @db.Timestamptz(6)
  created_at                                               DateTime                    @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                                               DateTime                    @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  cases_assigned                                           acquisition_cases[]         @relation("CaseOfficer")
  cases_created                                            acquisition_cases[]         @relation("CaseCreator")
  api_idempotency_keys                                     api_idempotency_keys[]
  audit_events                                             audit_events[]
  auth_sessions                                            auth_sessions[]
  awards_approved                                          award_calculations[]        @relation("AwardApprover")
  awards_calculated                                        award_calculations[]        @relation("AwardCalculator")
  case_quality_assessments                                 case_quality_assessments[]
  case_risk_evaluations                                    case_risk_evaluations[]
  stages_completed                                         case_stage_instances[]      @relation("StageCompleter")
  transitions_acted                                        case_workflow_transitions[] @relation("TransitionActor")
  policies_created                                         compensation_policies[]     @relation("PolicyCreator")
  doc_approvals_acted                                      document_approvals[]        @relation("DocumentApprovalActor")
  doc_versions_uploaded                                    document_versions[]         @relation("DocumentVersionUploader")
  documents_approved                                       documents[]                 @relation("DocumentApprover")
  documents_uploaded                                       documents[]                 @relation("DocumentUploader")
  field_surveys                                            field_surveys[]
  hearings_officered                                       grievance_hearings[]        @relation("HearingOfficer")
  grievances_assigned                                      grievances[]                @relation("GrievanceAssignee")
  media_assets                                             media_assets[]
  notifications                                            notifications[]
  offline_sync_records                                     offline_sync_records[]
  payments_initiated                                       payment_batches[]           @relation("PaymentInitiator")
  possessions_created                                      possession_records[]        @relation("PossessionCreator")
  possessions_field                                        possession_records[]        @relation("PossessionFieldOfficer")
  alignments_uploaded                                      project_alignments[]        @relation("AlignmentUploader")
  projects_created                                         projects[]                  @relation("ProjectCreator")
  projects_pia                                             projects[]                  @relation("ProjectPia")
  projects_updated                                         projects[]                  @relation("ProjectUpdater")
  statutory_notices                                        statutory_notices[]
  user_jurisdictions_user_jurisdictions_assigned_byTousers user_jurisdictions[]        @relation("user_jurisdictions_assigned_byTousers")
  user_jurisdictions                                       user_jurisdictions[]
  user_preferences                                         user_preferences?
  user_roles_user_roles_assigned_byTousers                 user_roles[]                @relation("user_roles_assigned_byTousers")
  user_roles                                               user_roles[]

  @@index([full_name], map: "idx_users_name")
  @@index([account_status], map: "idx_users_status")
}

model roles {
  role_code            String                 @id @db.VarChar(40)
  display_name         String                 @db.VarChar(160)
  description          String?                @db.VarChar(500)
  is_system_role       Boolean                @default(true)
  created_at           DateTime               @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  user_roles           user_roles[]
  workflow_stage_roles workflow_stage_roles[]
}

model user_roles {
  user_id                             String   @db.Uuid
  role_code                           String   @db.VarChar(40)
  assigned_by                         String?  @db.Uuid
  assigned_at                         DateTime @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  users_user_roles_assigned_byTousers users?   @relation("user_roles_assigned_byTousers", fields: [assigned_by], references: [user_id], onUpdate: NoAction, map: "fk_user_roles_assigned_by")
  roles                               roles    @relation(fields: [role_code], references: [role_code], onUpdate: NoAction, map: "fk_user_roles_role")
  users                               users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@id([user_id, role_code])
  @@index([role_code], map: "idx_user_roles_role")
}

model jurisdictions {
  jurisdiction_id        String                  @id @db.Uuid
  parent_jurisdiction_id String?                 @db.Uuid
  jurisdiction_type      String
  jurisdiction_code      String                  @db.VarChar(64)
  name                   String                  @db.VarChar(160)
  name_local             String?                 @db.VarChar(160)
  official_code          String?                 @db.VarChar(64)
  is_active              Boolean                 @default(true)
  created_at             DateTime                @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at             DateTime                @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  cases_district         acquisition_cases[]     @relation("CaseDistrict")
  cases_state            acquisition_cases[]     @relation("CaseState")
  audit_events           audit_events[]
  compensation_policies  compensation_policies[] @relation("PolicyJurisdiction")
  jurisdictions          jurisdictions?          @relation("jurisdictionsTojurisdictions", fields: [parent_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_jurisdictions_parent")
  other_jurisdictions    jurisdictions[]         @relation("jurisdictionsTojurisdictions")
  parcels_district       parcels[]               @relation("ParcelDistrict")
  parcels_state          parcels[]               @relation("ParcelState")
  parcels_taluk          parcels[]               @relation("ParcelTaluk")
  parcels_village        parcels[]               @relation("ParcelVillage")
  project_jurisdictions  project_jurisdictions[]
  projects_primary_state projects[]              @relation("ProjectPrimaryState")
  user_jurisdictions     user_jurisdictions[]

  @@unique([jurisdiction_type, jurisdiction_code], map: "uq_jurisdiction_type_code")
  @@index([name], map: "idx_jurisdictions_name")
  @@index([parent_jurisdiction_id], map: "idx_jurisdictions_parent")
}

model user_jurisdictions {
  user_id                                     String        @db.Uuid
  jurisdiction_id                             String        @db.Uuid
  access_type                                 String        @default("VIEW")
  valid_from                                  DateTime?     @db.Date
  valid_to                                    DateTime?     @db.Date
  assigned_by                                 String?       @db.Uuid
  assigned_at                                 DateTime      @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  users_user_jurisdictions_assigned_byTousers users?        @relation("user_jurisdictions_assigned_byTousers", fields: [assigned_by], references: [user_id], onUpdate: NoAction, map: "fk_user_jurisdictions_assigned_by")
  jurisdictions                               jurisdictions @relation(fields: [jurisdiction_id], references: [jurisdiction_id], onUpdate: NoAction, map: "fk_user_jurisdictions_jurisdiction")
  users                                       users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_jurisdictions_user")

  @@id([user_id, jurisdiction_id])
  @@index([jurisdiction_id], map: "idx_user_jurisdictions_jurisdiction")
}

model auth_sessions {
  session_id   String    @id @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique(map: "uq_auth_sessions_token_hash") @db.Char(64)
  ip_address   String?   @db.Inet
  user_agent   String?   @db.VarChar(512)
  created_at   DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  last_seen_at DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_sessions_user")

  @@index([user_id, expires_at], map: "idx_auth_sessions_user_expiry")
}

model api_idempotency_keys {
  idempotency_key     String   @id @db.VarChar(128)
  user_id             String?  @db.Uuid
  request_method      String   @db.VarChar(12)
  request_path        String   @db.VarChar(255)
  request_fingerprint String   @db.Char(64)
  response_status     Int?     @db.SmallInt
  response_body       Json?
  created_at          DateTime @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  expires_at          DateTime @db.Timestamptz(6)
  users               users?   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_idempotency_user")

  @@index([user_id, created_at], map: "idx_idempotency_user_created")
}

model document_types {
  document_type_code                String                              @id @db.VarChar(40)
  display_name                      String                              @db.VarChar(160)
  description                       String?                             @db.VarChar(500)
  is_publicly_visible               Boolean                             @default(false)
  created_at                        DateTime                            @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  documents                         documents[]
  workflow_stage_required_documents workflow_stage_required_documents[]
}

model workflow_stage_definitions {
  stage_code                        String                              @id @db.VarChar(40)
  stage_order                       Int                                 @unique(map: "uq_workflow_stage_order") @db.SmallInt
  display_name                      String                              @db.VarChar(180)
  display_name_local                String?                             @db.VarChar(180)
  description                       String?                             @db.VarChar(500)
  default_sla_days                  Int
  is_terminal                       Boolean                             @default(false)
  is_active                         Boolean                             @default(true)
  acquisition_cases                 acquisition_cases[]
  case_stage_instances              case_stage_instances[]
  transitions_from                  case_workflow_transitions[]         @relation("TransitionsFrom")
  transitions_to                    case_workflow_transitions[]         @relation("TransitionsTo")
  workflow_stage_required_documents workflow_stage_required_documents[]
  workflow_stage_roles              workflow_stage_roles[]
}

model workflow_stage_roles {
  stage_code                 String                     @db.VarChar(40)
  role_code                  String                     @db.VarChar(40)
  can_enter                  Boolean                    @default(true)
  can_approve                Boolean                    @default(false)
  roles                      roles                      @relation(fields: [role_code], references: [role_code], onUpdate: NoAction, map: "fk_workflow_stage_roles_role")
  workflow_stage_definitions workflow_stage_definitions @relation(fields: [stage_code], references: [stage_code], onDelete: Cascade, onUpdate: NoAction, map: "fk_workflow_stage_roles_stage")

  @@id([stage_code, role_code])
  @@index([role_code], map: "idx_workflow_stage_roles_role")
}

model workflow_stage_required_documents {
  stage_code                 String                     @db.VarChar(40)
  document_type_code         String                     @db.VarChar(40)
  is_mandatory               Boolean                    @default(true)
  workflow_stage_definitions workflow_stage_definitions @relation(fields: [stage_code], references: [stage_code], onDelete: Cascade, onUpdate: NoAction, map: "fk_required_documents_stage")
  document_types             document_types             @relation(fields: [document_type_code], references: [document_type_code], onUpdate: NoAction, map: "fk_required_documents_type")

  @@id([stage_code, document_type_code])
  @@index([document_type_code], map: "idx_required_documents_type")
}

model projects {
  project_id                    String                  @id @db.Uuid
  project_code                  String                  @unique(map: "uq_projects_code") @db.VarChar(100)
  title                         String                  @db.VarChar(240)
  sector                        String                  @db.VarChar(160)
  pia_name                      String                  @db.VarChar(240)
  pia_user_id                   String?                 @db.Uuid
  sponsoring_ministry           String?                 @db.VarChar(240)
  project_status                String                  @default("PLANNING")
  primary_state_jurisdiction_id String?                 @db.Uuid
  estimated_budget_inr          Decimal                 @default(0) @db.Decimal(20, 2)
  total_acquisition_area_ha     Decimal                 @default(0) @db.Decimal(18, 4)
  start_date                    DateTime?               @db.Date
  target_completion_date        DateTime?               @db.Date
  description                   String?
  external_reference            String?                 @db.VarChar(120)
  version_no                    Int                     @default(1)
  created_by                    String?                 @db.Uuid
  updated_by                    String?                 @db.Uuid
  created_at                    DateTime                @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                    DateTime                @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  archived_at                   DateTime?               @db.Timestamptz(6)
  acquisition_cases             acquisition_cases[]
  documents                     documents[]
  notifications                 notifications[]
  project_alignments            project_alignments[]
  project_jurisdictions         project_jurisdictions[]
  project_parcels               project_parcels[]
  creator                       users?                  @relation("ProjectCreator", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "fk_projects_created_by")
  pia_user                      users?                  @relation("ProjectPia", fields: [pia_user_id], references: [user_id], onUpdate: NoAction, map: "fk_projects_pia_user")
  primary_state                 jurisdictions?          @relation("ProjectPrimaryState", fields: [primary_state_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_projects_state")
  updater                       users?                  @relation("ProjectUpdater", fields: [updated_by], references: [user_id], onUpdate: NoAction, map: "fk_projects_updated_by")
  statutory_notices             statutory_notices[]
  project_risk_snapshots        project_risk_snapshots[]
  project_inter_agency_nocs     project_inter_agency_nocs[]

  @@index([primary_state_jurisdiction_id], map: "idx_projects_state")
  @@index([project_status], map: "idx_projects_status")
  @@index([target_completion_date], map: "idx_projects_target_date")
}

model project_jurisdictions {
  project_id      String        @db.Uuid
  jurisdiction_id String        @db.Uuid
  is_primary      Boolean       @default(false)
  jurisdictions   jurisdictions @relation(fields: [jurisdiction_id], references: [jurisdiction_id], onUpdate: NoAction, map: "fk_project_jurisdictions_jurisdiction")
  projects        projects      @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_jurisdictions_project")

  @@id([project_id, jurisdiction_id])
  @@index([jurisdiction_id], map: "idx_project_jurisdictions_jurisdiction")
}

model project_alignments {
  alignment_id       String            @id @db.Uuid
  project_id         String            @db.Uuid
  version_no         Int
  alignment_name     String            @db.VarChar(180)
  centerline_wgs84 Unsupported("geometry")
  right_of_way_wgs84 Unsupported("geometry")?
  alignment_metric Unsupported("geometry")?
  metric_srid        Int?
  buffer_width_m     Decimal           @default(0) @db.Decimal(10, 2)
  geometry_hash      String            @db.Char(64)
  status             String            @default("DRAFT")
  uploaded_by        String?           @db.Uuid
  created_at         DateTime          @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  activated_at       DateTime?         @db.Timestamptz(6)
  projects           projects          @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_alignments_project")
  uploader           users?            @relation("AlignmentUploader", fields: [uploaded_by], references: [user_id], onUpdate: NoAction, map: "fk_project_alignments_uploaded_by")
  project_parcels    project_parcels[]

  @@unique([project_id, geometry_hash], map: "uq_project_alignment_hash")
  @@unique([project_id, version_no], map: "uq_project_alignment_version")
  @@index([project_id, status], map: "idx_project_alignments_project_status")
}

model parcel_sources {
  parcel_source_id String    @id @db.Uuid
  source_code      String    @unique(map: "uq_parcel_sources_code") @db.VarChar(100)
  authority_name   String    @db.VarChar(240)
  dataset_name     String?   @db.VarChar(240)
  dataset_version  String?   @db.VarChar(100)
  imported_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  parcels          parcels[]
}

model parcels {
  parcel_id                  String            @id @db.Uuid
  parcel_source_id           String?           @db.Uuid
  source_record_key          String            @db.VarChar(128)
  ulpin                      String            @unique(map: "uq_parcels_ulpin") @db.VarChar(32)
  survey_number              String            @db.VarChar(100)
  khasra_number              String?           @db.VarChar(100)
  state_jurisdiction_id      String?           @db.Uuid
  district_jurisdiction_id   String?           @db.Uuid
  taluk_jurisdiction_id      String?           @db.Uuid
  village_jurisdiction_id    String?           @db.Uuid
  village_name               String            @db.VarChar(180)
  total_area_ha              Decimal           @db.Decimal(18, 4)
  land_use_category          String
  parcel_status              String            @default("IDENTIFIED")
  owner_reference            String?           @db.VarChar(80)
  owner_name_masked          String?           @db.VarChar(180)
  boundary_wgs84 Unsupported("geometry")
  centroid_wgs84 Unsupported("geometry")?
  is_disputed                Boolean           @default(false)
  dispute_reason             String?           @db.VarChar(500)
  estimated_market_value_inr Decimal           @default(0) @db.Decimal(20, 2)
  record_version             Int               @default(1)
  imported_at                DateTime?         @db.Timestamptz(6)
  created_at                 DateTime          @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                 DateTime          @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  documents                  documents[]
  grievances                 grievances[]
  parcel_owners              parcel_owners[]
  district                   jurisdictions?    @relation("ParcelDistrict", fields: [district_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_parcels_district")
  parcel_sources             parcel_sources?   @relation(fields: [parcel_source_id], references: [parcel_source_id], onUpdate: NoAction, map: "fk_parcels_source")
  state                      jurisdictions?    @relation("ParcelState", fields: [state_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_parcels_state")
  taluk                      jurisdictions?    @relation("ParcelTaluk", fields: [taluk_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_parcels_taluk")
  village                    jurisdictions?    @relation("ParcelVillage", fields: [village_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_parcels_village")
  project_parcels            project_parcels[]

  @@unique([parcel_source_id, source_record_key], map: "uq_parcels_source_record")
  @@index([is_disputed], map: "idx_parcels_disputed")
  @@index([khasra_number], map: "idx_parcels_khasra_number")
  @@index([parcel_status], map: "idx_parcels_status")
  @@index([survey_number], map: "idx_parcels_survey_number")
  @@index([village_jurisdiction_id, village_name], map: "idx_parcels_village")
}

model litigation_cases {
  litigation_id    String   @id @db.Uuid
  court_name       String   @db.VarChar(240)
  case_number      String   @db.VarChar(120)
  case_id          String?  @db.Uuid
  parcel_id        String?  @db.Uuid
  description      String?
  created_by       String   @db.Uuid
  litigation_status String  @default("FILED") @db.VarChar(40)
  created_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at       DateTime @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)

  @@index([case_id], map: "idx_litigation_cases_case")
  @@index([parcel_id], map: "idx_litigation_cases_parcel")
  @@index([litigation_status], map: "idx_litigation_cases_status")
}

model project_parcels {
  project_parcel_id          String              @id @db.Uuid
  project_id                 String              @db.Uuid
  parcel_id                  String              @db.Uuid
  alignment_id               String?             @db.Uuid
  impact_status              String              @default("IDENTIFIED")
  impacted_area_ha           Decimal             @default(0) @db.Decimal(18, 4)
  acquired_area_ha           Decimal             @default(0) @db.Decimal(18, 4)
  impact_geometry_wgs84 Unsupported("geometry")?
  intersection_calculated_at DateTime?           @db.Timestamptz(6)
  intersection_method        String?             @db.VarChar(80)
  notes                      String?             @db.VarChar(1000)
  created_at                 DateTime            @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                 DateTime            @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  case_parcels               case_parcels[]
  alignments                 project_alignments? @relation(fields: [alignment_id], references: [alignment_id], onUpdate: NoAction, map: "fk_project_parcels_alignment")
  parcels                    parcels             @relation(fields: [parcel_id], references: [parcel_id], onUpdate: NoAction, map: "fk_project_parcels_parcel")
  projects                   projects            @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_parcels_project")

  @@unique([project_id, parcel_id], map: "uq_project_parcel")
  @@index([parcel_id], map: "idx_project_parcels_parcel")
  @@index([project_id, impact_status], map: "idx_project_parcels_project_status")
}

model acquisition_cases {
  case_id                    String                      @id @db.Uuid
  case_number                String                      @unique(map: "uq_acquisition_cases_number") @db.VarChar(120)
  project_id                 String                      @db.Uuid
  state_jurisdiction_id      String?                     @db.Uuid
  district_jurisdiction_id   String?                     @db.Uuid
  current_stage_code         String                      @db.VarChar(40)
  case_status                String                      @default("DRAFT")
  stage_updated_at           DateTime                    @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  sla_deadline               DateTime?                   @db.Timestamptz(6)
  is_sla_breached            Boolean                     @default(false)
  days_remaining_in_sla      Int?
  total_acquisition_area_ha  Decimal                     @default(0) @db.Decimal(18, 4)
  total_beneficiaries_count  Int                         @default(0)
  data_quality_score         Decimal                     @default(0) @db.Decimal(5, 2)
  data_quality_passed_checks Int                         @default(0)
  data_quality_total_checks  Int                         @default(0)
  delay_risk_level           String                      @default("LOW")
  estimated_compensation_inr Decimal                     @default(0) @db.Decimal(20, 2)
  disbursed_compensation_inr Decimal                     @default(0) @db.Decimal(20, 2)
  assigned_officer_user_id   String?                     @db.Uuid
  version_no                 Int                         @default(1)
  created_by                 String?                     @db.Uuid
  created_at                 DateTime                    @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                 DateTime                    @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  completed_at               DateTime?                   @db.Timestamptz(6)
  officer                    users?                      @relation("CaseOfficer", fields: [assigned_officer_user_id], references: [user_id], onUpdate: NoAction, map: "fk_cases_assigned_officer")
  creator                    users?                      @relation("CaseCreator", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "fk_cases_created_by")
  workflow_stage_definitions workflow_stage_definitions  @relation(fields: [current_stage_code], references: [stage_code], onUpdate: NoAction, map: "fk_cases_current_stage")
  district                   jurisdictions?              @relation("CaseDistrict", fields: [district_jurisdiction_id], references: [jurisdiction_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_cases_district")
  projects                   projects                    @relation(fields: [project_id], references: [project_id], onUpdate: NoAction, map: "fk_cases_project")
