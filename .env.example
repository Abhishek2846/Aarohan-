# ==============================================================================
# Aarohan Enterprise Monorepo - Environment Template
# Copy this file to .env for root orchestration or per-package configurations
# ==============================================================================

# Backend Port & Network URL
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Frontend API Target
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"

# Database & Security Secrets
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aarohanDb?schema=public"
JWT_SECRET="aarohan_setu_jwt_secret_dev_key_2026_change_in_production"
ENCRYPTION_KEY="aarohan-enterprise-pii-secret-key-32bytes"

# Public Shareable Demo Overrides (Optional custom NGROK / Cloudflare Tunnel domains)
# When running "npm run public", NGROK automatically establishes tunnels and configures URLs.
# PUBLIC_BACKEND_URL="https://your-custom-backend.ngrok-free.app/v1"
# PUBLIC_FRONTEND_URL="https://your-custom-frontend.ngrok-free.app"
